---
import { readdirSync } from "node:fs";
import { join, extname, basename } from "node:path";
import cuttingmatSrc from "../assets/photos/cuttingmat.png";

// Discover photos at build time — no more 50 blind JS probes
const fotosDir = join(process.cwd(), "public/fotos");
const photoExts = new Set([".jpg", ".jpeg", ".png", ".webp", ".avif"]);
const photoFiles = readdirSync(fotosDir)
  .filter(f => photoExts.has(extname(f).toLowerCase()))
  .sort((a, b) => {
    const numA = parseInt(a.match(/\d+/)?.[0] ?? "0");
    const numB = parseInt(b.match(/\d+/)?.[0] ?? "0");
    return numA - numB;
  })
  .map(filename => ({
    full: `/fotos/${filename}`,
    // make-thumbs.mjs always outputs .jpg regardless of source extension
    thumb: `/fotos/thumbs/${basename(filename, extname(filename))}.jpg`,
  }));
---

<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="fotos i've taken/made">
    <meta name="robots" content="index, follow">
    <title>fotos i've taken/made</title>
    <link rel="icon" href="/mountain.png" type="image/png" />

    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            padding: 8px;
            background-color: black;
            font-family: Arial, sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .return-link {
            position: fixed;
            top: 30px;
            left: 36px;
            color: red;
            font-size: 16px;
            text-decoration: none;
            z-index: 2000;
            transition: transform 0.2s ease;
        }
        .return-link:hover { transform: scale(1.05); }

        .photos-container {
            display: grid;
            grid-auto-rows: 200px;
            justify-content: center;
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 60px 20px 20px;
            position: relative;
        }

        .photos-container::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-image: var(--bg-tex);
            background-repeat: repeat;
            background-position: center;
            border-radius: 8px;
            z-index: -1;
            pointer-events: none;
        }

        .photo-item {
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            border-radius: 4px;
            background-color: #111;
            cursor: pointer;
            position: relative;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .photo-item img {
            object-fit: cover;
            object-position: center;
            width: 100%;
            height: 100%;
        }

        .photo-item.error img { display: none; }

        .photo-item.error {
            background: #2a0a0a;
            border: 1px solid #441111;
        }
        .photo-item.error::before {
            content: "✕";
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            color: #aa4444;
            font-size: 24px;
        }

        /* Modal */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.9);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 3000;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease, visibility 0.3s ease;
            backdrop-filter: blur(10px);
        }
        .modal-overlay.active { opacity: 1; visibility: visible; }

        .modal-content {
            position: relative;
            max-width: 90vw;
            max-height: 90vh;
            transform: scale(0.8);
            transition: transform 0.3s ease;
        }
        .modal-overlay.active .modal-content { transform: scale(1); }

        .modal-image {
            width: auto; height: auto;
            max-width: 90vw; max-height: 90vh;
            object-fit: contain;
            border-radius: 8px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.5);
        }

        .modal-close {
            position: absolute;
            top: -40px; right: 0;
            color: white;
            font-size: 24px;
            cursor: pointer;
            background: rgba(0,0,0,0.5);
            width: 32px; height: 32px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: background 0.2s ease;
        }
        .modal-close:hover { background: rgba(255,255,255,0.2); }

        @media (max-width: 480px) {
            .photos-container {
                grid-template-columns: repeat(auto-fill, 75px);
                gap: 0;
                grid-auto-rows: 75px;
                padding-top: 67px;
            }
            .photos-container::before {
                top: 55px;
                height: calc(100% - 55px);
            }
        }

        @media (481px <= width <= 768px) {
            .photos-container {
                grid-template-columns: repeat(auto-fill, 150px);
                gap: 0;
                grid-auto-rows: 150px;
            }
        }

        @media (769px <= width <= 1200px) {
            .photos-container {
                grid-template-columns: repeat(auto-fill, 150px);
                gap: 0;
                grid-auto-rows: 150px;
            }
        }

        @media (min-width: 1201px) {
            .photos-container {
                grid-template-columns: repeat(auto-fill, 240px);
                gap: 0;
                grid-auto-rows: 240px;
            }
        }
    </style>
</head>
<body>
    <a href="/" class="return-link">return</a>

    <div
      class="photos-container"
      id="photosContainer"
      style={`--bg-tex: url('${cuttingmatSrc.src}')`}
    >
        {photoFiles.map(photo => (
          <div class="photo-item" data-full={photo.full}>
            <img
              src={photo.thumb}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
    </div>

    <div class="modal-overlay" id="modalOverlay">
        <div class="modal-content">
            <div class="modal-close" id="modalClose">×</div>
            <img class="modal-image" id="modalImage" alt="Full size photo">
        </div>
    </div>

<script>
    const modal = document.getElementById('modalOverlay') as HTMLElement;
    const modalImage = document.getElementById('modalImage') as HTMLImageElement;
    const modalClose = document.getElementById('modalClose');
    const fallbackImage = '/imagenotfound.jpeg';

    // Build ordered list of valid photo paths from the grid
    const items = Array.from(document.querySelectorAll<HTMLElement>('.photo-item'));
    const photos: string[] = items
        .filter(el => !el.classList.contains('error') && !!el.dataset.full)
        .map(el => el.dataset.full as string);

    let currentIndex = 0;

    // Mark tiles whose thumbnail failed to load
    items.forEach(item => {
        const img = item.querySelector('img');
        if (img) img.onerror = () => item.classList.add('error');
    });

    // Open modal on tile click
    items.forEach(item => {
        item.addEventListener('click', () => {
            if (item.classList.contains('error')) return;
            const full = item.dataset.full;
            if (!full) return;
            const idx = photos.indexOf(full);
            if (idx !== -1) {
                currentIndex = idx;
                openModal(full);
            }
        });
    });

    // Return link: go back if history exists, else home
    document.querySelector('.return-link')?.addEventListener('click', e => {
        e.preventDefault();
        window.history.length > 1 ? window.history.back() : (window.location.href = '/');
    });

    modalClose?.addEventListener('click', closeModal);
    modal?.addEventListener('click', e => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', e => {
        if (!modal.classList.contains('active')) return;
        if (e.key === 'Escape') closeModal();
        if (e.key === 'ArrowRight') navigate(1);
        if (e.key === 'ArrowLeft')  navigate(-1);
    });

    function openModal(imagePath: string, direction: 'left' | 'right' | null = null) {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';

        if (direction) {
            modalImage.style.transition = 'none';
            modalImage.style.transform = direction === 'right' ? 'translateX(40px)' : 'translateX(-40px)';
            modalImage.style.opacity = '0';
            requestAnimationFrame(() => {
                modalImage.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
            });
        } else {
            modalImage.style.opacity = '0.5';
        }

        const full = new Image();
        full.onload = () => {
            modalImage.src = imagePath;
            modalImage.style.transform = 'translateX(0)';
            modalImage.style.opacity = '1';
        };
        full.onerror = () => {
            modalImage.src = fallbackImage;
            modalImage.style.transform = 'translateX(0)';
            modalImage.style.opacity = '1';
        };
        full.src = imagePath;

        // Preload neighbors
        const prev = photos[currentIndex - 1];
        const next = photos[currentIndex + 1];
        if (prev) new Image().src = prev;
        if (next) new Image().src = next;
    }

    function navigate(delta: number) {
        const next = currentIndex + delta;
        if (next < 0 || next >= photos.length) return;
        currentIndex = next;
        openModal(photos[currentIndex], delta > 0 ? 'left' : 'right');
    }

    function closeModal() {
        modal.classList.remove('active');
        document.body.style.overflow = '';
        setTimeout(() => {
            if (!modal.classList.contains('active')) modalImage.src = '';
        }, 300);
    }

    // Swipe detection (mobile)
    let swipeStartX = 0;
    let swipeStartY = 0;
    let isSwiping = false;

    modal.addEventListener('touchstart', e => {
        swipeStartX = e.touches[0].clientX;
        swipeStartY = e.touches[0].clientY;
        isSwiping = true;
    }, { passive: true });

    modal.addEventListener('touchend', e => {
        if (!isSwiping) return;
        isSwiping = false;
        const dx = e.changedTouches[0].clientX - swipeStartX;
        const dy = e.changedTouches[0].clientY - swipeStartY;
        // Only register as horizontal swipe if horizontal movement dominates
        if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
        navigate(dx < 0 ? 1 : -1);
    }, { passive: true });

    modal.addEventListener('touchmove', e => {
        // Allow default scroll if mostly vertical; prevent if horizontal swipe
        const dx = Math.abs(e.touches[0].clientX - swipeStartX);
        const dy = Math.abs(e.touches[0].clientY - swipeStartY);
        if (dx > dy) e.preventDefault();
    }, { passive: false });
</script>
</body>
</html>

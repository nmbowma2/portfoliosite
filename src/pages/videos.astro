---
import ReturnLink from "../components/ReturnLink.astro";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="videos i've made">
    <meta name="robots" content="index, follow">
    <title>videos i've made</title>
    <link rel="icon" href="/premiere.png" type="image/png" />
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: black;
            font-family: Arial, sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Mobile Layout - Standard Grid */
        .media-container {
            border: 10px;
            display: grid;
            grid-template-columns: 1fr;
            gap: 2rem;
            padding: 4rem 2rem 2rem 2rem;
            max-width: 1200px;
            margin: 0 auto;
            --rows: 10;
            --cols: 10;
            position: relative;
            background-image: radial-gradient(circle, rgba(255, 255, 255, 0.682) 1.75px, transparent 1px);
            background-size: calc(100% / var(--cols)) calc(100% / var(--rows));
            background-position: 0 0;
            background-repeat: repeat;
        }

        .media-embed {
            aspect-ratio: 4/3;
            border-radius: 0px;
            border: 0px solid #EBECF0;
            overflow: hidden;
            transition: transform 0.3s ease;
            box-shadow: 0px 2px 5px rgba(192, 192, 192, 0.3);
        }

        .media-embed:hover {
            transform: scale(1.025);
        }

        .media-embed iframe,
        .media-embed img {
            width: 100%;
            height: 100%;
            border: none;
            border-radius: 0px;
            display: block;
            object-fit: cover;
        }

        /* phone - 2 columns */
        @media (max-width: 768px) {
            .media-container {
                --rows: 15;
                --cols: 7;
                grid-template-columns: repeat(8, 1fr);
                gap: 1rem;
                padding: 4rem 2rem 2rem 2rem;
            }
            .media-embed:nth-child(1) {
                grid-column: 3 / span 6;
                grid-row: 2 / span 5;
            }
            .media-embed:nth-child(2) {
                grid-column: 6 / span 8;
                grid-row: 7 / span 7;
            }
            .media-embed:nth-child(3) {
                grid-column: 2 / span 6;
                grid-row: 13 / span 5;
            }
            .media-embed:nth-child(4) {
                grid-column: 3 / span 9;
                grid-row: 20 / span 7;
            }
            .media-embed:nth-child(5) {
                grid-column: 1 / span 4;
                grid-row: 8 / span 4;
            }
            .media-embed:nth-child(6) {
                grid-column: 8 / span 6;
                grid-row: 16 / span 6;
            }
            .media-embed:nth-child(7) {
                grid-column: 1 / span 6;
                grid-row: 28 / span 6;
            }
        }

        /* Desktop - Random scattered grid */
        @media (min-width: 1024px) {
            .media-container {
                --rows: 10;
                --cols: 10;
                grid-template-columns: repeat(8, 1fr);
                grid-template-rows: repeat(9, 120px);
                gap: 1.5rem;
                padding: 4rem;
            }
            .media-embed:nth-child(1) {
                grid-column: 1 / span 2;
                grid-row: 1 / span 2;
            }
            .media-embed:nth-child(2) {
                grid-column: 6 / span 3;
                grid-row: 1 / span 2;
            }
            .media-embed:nth-child(3) {
                grid-column: 1 / span 2;
                grid-row: 4 / span 2;
            }
            .media-embed:nth-child(4) {
                grid-column: 5 / span 2;
                grid-row: 4 / span 2;
            }
            .media-embed:nth-child(5) {
                grid-column: 3 / span 2;
                grid-row: 2 / span 2;
            }
            .media-embed:nth-child(6) {
                grid-column: 7 / span 2;
                grid-row: 3 / span 2;
            }
            .media-embed:nth-child(7) {
                grid-column: 3 / span 3;
                grid-row: 5 / span 2;
            }
        }

        /* Large Desktop - Even more scattered */
        @media (min-width: 1400px) {
            .media-container {
                grid-template-columns: repeat(12, 1fr);
                grid-template-rows: repeat(12, 100px);
                gap: 2rem;
                padding: 5rem;
                --rows: 10;
                --cols: 10;
            }
            .media-embed:nth-child(1) {
                grid-column: 2 / span 3;
                grid-row: 1 / span 4;
            }
            .media-embed:nth-child(2) {
                grid-column: 8 / span 3;
                grid-row: 2 / span 2;
            }
            .media-embed:nth-child(3) {
                grid-column: 1 / span 4;
                grid-row: 5 / span 4;
            }
            .media-embed:nth-child(4) {
                grid-column: 6 / span 3;
                grid-row: 4 / span 2;
            }
            .media-embed:nth-child(5) {
                grid-column: 4 / span 2;
                grid-row: 3 / span 2;
            }
            .media-embed:nth-child(6) {
                grid-column: 10 / span 3;
                grid-row: 5 / span 3;
            }
            .media-embed:nth-child(7) {
                grid-column: 4 / span 4;
                grid-row: 10 / span 3;
            }
        }

        /* Featured video section */
        .featured-section {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem 2rem 4rem;
        }

        .featured-embed {
            width: 100%;
            aspect-ratio: 16/9;
            border: none;
            display: block;
            box-shadow: 0px 4px 24px rgba(192, 192, 192, 0.15);
        }

        @media (max-width: 768px) {
            .featured-section {
                padding: 1.5rem 1rem 3rem;
            }
        }
    </style>
</head>
<body>
    <ReturnLink />

    <div class="media-container">
        <div class="media-embed">
            <iframe
                src="https://www.youtube.com/embed/PHxJKbK3a14"
                title="YouTube video 1"
                allowfullscreen
                loading="lazy">
            </iframe>
        </div>

        <div class="media-embed">
            <iframe
                src="https://www.youtube.com/embed/vh77Yvnk178"
                title="YouTube video 2"
                allowfullscreen
                loading="lazy">
            </iframe>
        </div>

        <div class="media-embed">
            <iframe
                src="https://www.youtube.com/embed/WiFsMZuCX7U"
                title="YouTube video 3"
                allowfullscreen
                loading="lazy">
            </iframe>
        </div>

        <div class="media-embed">
            <iframe
                src="https://www.youtube.com/embed/n4t7pJDpXeU"
                title="YouTube video 4"
                allowfullscreen
                loading="lazy">
            </iframe>
        </div>

        <div class="media-embed">
            <img
                src="/imagenotfound.jpeg"
                alt="Sample Image 1"
                loading="lazy">
        </div>

        <div class="media-embed">
            <img
                src="/imagenotfound.jpeg"
                alt="Sample Image 2"
                loading="lazy">
        </div>

        <div class="media-embed">
            <iframe
                src="https://www.youtube.com/embed/OmEPQyUSep4"
                title="YouTube video 7"
                allowfullscreen
                loading="lazy">
            </iframe>
        </div>
    </div>

    <div class="featured-section">
        <iframe
            class="featured-embed"
            src="https://www.youtube.com/embed/l1O6aZ9Yy_w"
            title="YouTube video 5"
            allowfullscreen
            loading="lazy">
        </iframe>
    </div>

</body>
</html>

---
import headerPng from "../assets/photos/fotosspecial-01.png";
import ReturnLink from "../components/ReturnLink.astro";

const playlistId = Astro.url.searchParams.get("id") ?? "37NPbY0z9gQtZp7t5cbjFh";
const playlistSrc = `https://open.spotify.com/embed/playlist/${playlistId}?utm_source=generator&theme=0`;

---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="recent music">
    <meta name="robots" content="index, follow">
    <title>recent music</title>
    <link rel="icon" href="/vinyl.png" type="image/png" />

  </head>
  <body>
    <div class="container">
      <ReturnLink />

      <!-- PNG image at top -->
      <div class="image-container">
        <img
          src={headerPng.src}
          width={headerPng.width}
          height={headerPng.height}
          alt="Music Header"
          class="header-image"
        />
      </div>

      <!-- Spotify playlist container -->
      <div class="spotify-container">
        <div id="playlist-container">
          <iframe
            title="Spotify playlist"
            src={playlistSrc}
            width="100%"
            height="600"
            style="border:0; border-radius:12px"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
          ></iframe>

        </div>
      </div>
    </div>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background-color: black;
        color: white;
        font-family: Arial, sans-serif;
        min-height: 100vh;
        overflow-x: hidden;
      }

      .container {
        width: 100%;
        min-height: 100vh;
        position: relative;
      }

      .image-container {
        position: absolute;
        top: -15.5%;
        left: 50%;
        max-height: 200%;
        transform: translateX(-50%) scale(1.5);
        z-index: 999;
        pointer-events: none;
      }

      .header-image {
        max-width: 50vw;
        height: auto;
        display: block;
      }

      .spotify-container {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: 100vh;
        padding: 20px;
        padding-top: 230px; /* Adjust based on your image height */
      }

      #playlist-container {
        width: 100%;
        max-width: 800px;
        text-align: center;
      }

      @media (max-width: 768px) {
        .return-link {
          font-size: 14px;
        }
        
        .image-container {
          top: 2.5%;
          left: 50%;
          transform: translateX(-50%) scale(2.25);
        }
        .spotify-container {
          padding-top: 150px;
        }
      }
    </style>
  </body>
</html>
